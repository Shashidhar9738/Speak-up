PORT=3000
NODE_ENV=development

# Comma-separated allowlist. Checked at login AND on every authenticated request,
# so removing an email here revokes existing tokens immediately.
SPEAKUP_ADMIN_EMAILS=jane.doe@company.com,admin@speakup.local

# REQUIRED in production, minimum 32 characters. The server refuses to start
# without it when NODE_ENV=production. In development an ephemeral secret is
# generated at boot, so tokens do not survive a restart.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SPEAKUP_ADMIN_SECRET=

SPEAKUP_TOKEN_TTL_HOURS=12

# Set to your dashboard origin in production. "*" is development only.
SPEAKUP_CORS_ORIGIN=*

SPEAKUP_AUTH_RATE_WINDOW_MS=900000
SPEAKUP_AUTH_RATE_MAX=10
SPEAKUP_SUBMISSION_RATE_WINDOW_MS=900000
SPEAKUP_SUBMISSION_RATE_MAX=5

# SPEAKUP_DATA_FILE=backend/data/submissions.json
