PORT=3000
NODE_ENV=development

# Comma-separated allowlist. Checked at login AND on every authenticated request,
# so removing an email here revokes existing tokens immediately.
SPEAKUP_ADMIN_EMAILS=jane.doe@company.com,admin@speakup.local

# REQUIRED in production, minimum 32 characters. The server refuses to start
# without it when NODE_ENV=production. In development an ephemeral secret is
# generated at boot, so tokens do not survive a restart.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SPEAKUP_ADMIN_SECRET=

SPEAKUP_TOKEN_TTL_HOURS=12

# Set to your dashboard origin in production. "*" is development only.
SPEAKUP_CORS_ORIGIN=*

SPEAKUP_AUTH_RATE_WINDOW_MS=900000
SPEAKUP_AUTH_RATE_MAX=10
SPEAKUP_SUBMISSION_RATE_WINDOW_MS=900000
SPEAKUP_SUBMISSION_RATE_MAX=5

# SPEAKUP_DATA_FILE=backend/data/submissions.json

# ---------------------------------------------------------------------------
# Optional integrations. All off unless set; the app runs fine without them.
# ---------------------------------------------------------------------------

# Email — dashboard accounts only (verification codes, password-change alerts).
# Never used to contact a reporter: they have no address on file, by design.
# SPEAKUP_SMTP_URL=smtps://user:pass@smtp.gmail.com:465
# SPEAKUP_MAIL_FROM=SpeakUp <noreply@comviva.com>

# Outbound webhook for HRIS/ticketing. Metadata only — complaint text is never
# sent. Signed with HMAC-SHA256 as X-SpeakUp-Signature when a secret is set.
# SPEAKUP_WEBHOOK_URL=https://hris.example.com/hooks/speakup
# SPEAKUP_WEBHOOK_SECRET=
# SPEAKUP_WEBHOOK_EVENTS=submission.created,submission.escalated
# SPEAKUP_WEBHOOK_TIMEOUT_MS=5000

# Serve HTTPS directly. Behind a proxy that terminates TLS (Render, nginx),
# leave these unset and set SPEAKUP_BEHIND_TLS=true instead.
#   npm run tls:generate     # self-signed, development only
# SPEAKUP_TLS_KEY=backend/certs/localhost-key.pem
# SPEAKUP_TLS_CERT=backend/certs/localhost-cert.pem

# Delete resolved cases this many days after resolution. 0 disables.
# Run `npm run purge` (dry run) then `npm run purge -- --apply`.
# SPEAKUP_RETENTION_DAYS=365
