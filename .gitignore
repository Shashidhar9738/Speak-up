# Secrets — never commit. Use .env.example as the template.
.env
.env.local
.env.*.local

# Working dashboard passwords. The repository is public; committing this would
# publish them, and once deployed that is owner access to every complaint.
CREDENTIALS.md

node_modules/
dist/

# Runtime data — the SQLite database, the audit log, and the legacy JSON
# stores. Real complaints, employee email addresses and appreciation records
# that name individuals. None of it belongs in version control.
backend/data/
!backend/data/.gitkeep
backend/backups/
backend/certs/

# UI screenshots — useful locally, but binary and regenerable.
test-artifacts/
frontend_backup/
snapshots/

# There is one package.json, at the root. A second one inside backend/ forks
# the dependency tree and its scripts resolve to paths that do not exist.
backend/package.json
backend/package-lock.json
backend/node_modules/

npm-debug.log*
*.log
.DS_Store
Thumbs.db
